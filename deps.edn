{:paths ["cljlox/src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.4"}
  org.clojure/tools.cli {:mvn/version "1.1.230"}}

 :aliases
 {:dev
  {:extra-paths ["cljlox/dev" "cljlox/test"]
   :extra-deps {metosin/malli {:mvn/version "0.20.1"}}}

  :test
  {:extra-paths ["cljlox/test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                metosin/malli {:mvn/version "0.20.1"}}
   :main-opts ["-m" "kaocha.runner"]}

  :run
  {:main-opts ["-m" "lox.main"]}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}

  :cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.3"}}}}}
