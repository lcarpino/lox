{:paths ["cljlox/src"]

 ;; NOTE: currently the versions here must match those used by rules_clojure, otherwise we will encounter issues with
 ;; maven not being able to download them. Seems like a bug.
 :deps
 {org.clojure/clojure {:mvn/version "1.12.1"}
  org.clojure/tools.cli {:mvn/version "1.3.250"}}

 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 :aliases
 {:dev
  {:extra-paths ["cljlox/dev" "cljlox/test"]
   :extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.03"}
                metosin/malli {:mvn/version "0.20.1"}}}

  :profile {:alias-deps  [:dev]
            :extra-deps  {com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.8.0"}}
            :jvm-opts    ["-Djdk.attach.allowAttachSelf"
                          "-XX:+UnlockDiagnosticVMOptions"
                          "-XX:+DebugNonSafepoints"]}

  :test
  {:extra-paths ["cljlox/test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                metosin/malli {:mvn/version "0.20.1"}}
   :main-opts ["-m" "kaocha.runner"]}

  :run
  {:main-opts ["-m" "lox.main"]}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}

  :cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.3"}}}}}
