{:deps {:aliases [:cljs]}

 :dev-http {8080 "cljlox/web"}

 :builds
 {:node {:target :node-script
         :output-to "target/node/cljslox.js"
         :main lox.main/main}

  :web  {:target :browser
         :output-dir "cljlox/web/js"
         :asset-path "/js"
         :modules {:main {:init-fn lox.web/init}}}}}
